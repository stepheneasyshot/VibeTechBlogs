---
import type { TocHeading } from '../utils/posts';

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
const tocItems = headings.filter((h) => h.depth <= 3);
---

{
  tocItems.length > 0 && (
    <aside class="hidden lg:block w-64 sticky top-32 self-start">
      <div class="p-6 border border-outline-variant/30 rounded-xl bg-surface-container-lowest max-h-[calc(100vh-9rem)] overflow-y-auto toc-scroll">
        <h4 class="font-headline text-[16px] uppercase tracking-widest text-on-surface-variant mb-stack-md font-semibold">
          目录
        </h4>
        <ul class="space-y-4">
          {tocItems.map((heading) => (
            <li style={heading.depth === 3 ? 'padding-left: 1rem' : undefined}>
              <a
                href={`#${heading.slug}`}
                data-toc-link={heading.slug}
                class="toc-link font-label text-label-md text-on-surface-variant hover:text-primary transition-all duration-200 flex items-center gap-2 border-l-2 border-transparent pl-3 -ml-[2px]"
              >
                <span class="toc-link-dot w-1 h-1 bg-tertiary-fixed-dim rounded-full shrink-0 opacity-40 transition-all duration-200" />
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-stack-lg pt-stack-md border-t border-outline-variant/20">
          <p class="font-label text-label-md text-on-surface-variant mb-4">分享文章</p>
          <div class="flex gap-4">
            <button
              type="button"
              id="share-btn"
              class="material-symbols-outlined text-[20px] text-on-surface-variant hover:text-tertiary-fixed-dim transition-colors cursor-pointer"
              aria-label="分享"
            >
              share
            </button>
          </div>
        </div>
      </div>
    </aside>
  )
}

<script>
  let tocObserver: IntersectionObserver | undefined;
  let tocScrollHandler: (() => void) | undefined;

  function setActiveTocLink(activeId: string) {
    document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((link) => {
      link.classList.toggle('toc-link-active', link.dataset.tocLink === activeId);
    });
  }

  function initTocSpy() {
    tocObserver?.disconnect();
    tocObserver = undefined;
    if (tocScrollHandler) {
      window.removeEventListener('scroll', tocScrollHandler);
      tocScrollHandler = undefined;
    }

    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (!tocLinks.length) return;

    tocLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.dataset.tocLink;
        if (!id) return;
        const target = document.getElementById(id);
        if (!target) return;
        event.preventDefault();
        history.replaceState(null, '', `#${id}`);
        const y = target.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top: y, behavior: 'smooth' });
      });
    });

    const headings = Array.from(tocLinks)
      .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => el !== null);

    if (!headings.length) return;

    const visibleIds = new Set<string>();
    setActiveTocLink(headings[0].id);

    const syncActive = () => {
      const nearBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 48;

      if (nearBottom) {
        setActiveTocLink(headings[headings.length - 1].id);
        return;
      }

      const activeId = headings.map((h) => h.id).filter((id) => visibleIds.has(id)).at(-1);
      if (activeId) setActiveTocLink(activeId);
    };

    tocObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            visibleIds.add(entry.target.id);
          } else {
            visibleIds.delete(entry.target.id);
          }
        });
        syncActive();
      },
      {
        rootMargin: '-80px 0px -55% 0px',
        threshold: 0,
      },
    );

    headings.forEach((heading) => tocObserver!.observe(heading));
    tocScrollHandler = syncActive;
    window.addEventListener('scroll', tocScrollHandler, { passive: true });
  }

  function initShare() {
    const btn = document.getElementById('share-btn');
    if (!btn) return;
    btn.onclick = async () => {
      if (navigator.share) {
        await navigator.share({ title: document.title, url: window.location.href });
      } else {
        await navigator.clipboard.writeText(window.location.href);
      }
    };
  }

  function init() {
    initTocSpy();
    initShare();
  }

  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    tocObserver?.disconnect();
    if (tocScrollHandler) {
      window.removeEventListener('scroll', tocScrollHandler);
      tocScrollHandler = undefined;
    }
  });
</script>
