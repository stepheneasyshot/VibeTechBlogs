---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import CommandPalette from './CommandPalette.astro';
import ReadingProgress from './ReadingProgress.astro';
import { cn } from '../utils/cn';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(href: string) {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  if (href === '/blog') {
    return (
      currentPath === '/blog/'
      || currentPath === '/blog'
      || currentPath.startsWith('/category/')
      || /^\/blog\/[^/]+\/?$/.test(currentPath)
    );
  }
  return currentPath.startsWith(href);
}
---

<!--
  实色背景（无毛玻璃）。transition:name 必须显式设为 site-header：
  persist 的值只是匹配 key，不会设置 view-transition-name。
-->
<header
  class="fixed top-0 w-full z-50 bg-surface-wash-header backdrop-blur-md elevation-1"
  transition:persist="site-header"
  transition:name="site-header"
  transition:animate="none"
>
  <ReadingProgress />
  <nav class="max-w-[1200px] mx-auto px-gutter flex items-center justify-between h-14">
    <div class="flex items-center gap-3 md:gap-6 min-w-0">
      <a
        href="/"
        data-nav-root
        class="font-headline text-[15px] sm:text-[17px] md:text-[18px] font-bold text-tertiary-fixed-dim tracking-tight whitespace-nowrap"
      >
        {site.name}
      </a>
      <div class="flex gap-3 md:gap-5 items-stretch">
        {site.nav.map((item) => (
          <a
            href={item.href}
            data-nav-link={item.href}
            class={cn(
              'font-headline text-[13px] md:text-[14px] flex items-center border-b-2 -mb-px transition-colors duration-200 cursor-pointer active:opacity-70 whitespace-nowrap',
              isActive(item.href)
                ? 'text-tertiary-fixed-dim border-tertiary-fixed-dim'
                : 'text-on-surface-variant border-transparent hover:text-tertiary-fixed-dim',
            )}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
    <div class="flex items-center gap-0.5 shrink-0">
      <CommandPalette />
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  function isNavActive(href: string, path: string) {
    if (href === '/') {
      return path === '/' || path === '';
    }
    if (href === '/blog') {
      return (
        path === '/blog/'
        || path === '/blog'
        || path.startsWith('/category/')
        || /^\/blog\/[^/]+\/?$/.test(path)
      );
    }
    return path.startsWith(href);
  }

  function setNavLinksTransition(enabled: boolean) {
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      link.style.transition = enabled ? '' : 'none';
    });
  }

  function updateHeader(pathArg?: string, options?: { instant?: boolean }) {
    const path = pathArg ?? window.location.pathname;
    const instant = options?.instant === true;

    if (instant) setNavLinksTransition(false);

    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      const href = link.dataset.navLink;
      if (!href) return;
      const active = isNavActive(href, path);
      link.classList.toggle('text-tertiary-fixed-dim', active);
      link.classList.toggle('border-tertiary-fixed-dim', active);
      link.classList.toggle('border-transparent', !active);
      link.classList.toggle('text-on-surface-variant', !active);
      if (active) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });

    if (instant) {
      // 强制 reflow，确保随后的 VT OLD 快照捕获到最终颜色
      void document.body.offsetWidth;
    }
  }

  function handleNavClick(event: MouseEvent) {
    const target = event.target as Element | null;
    const link = (target?.closest?.('[data-nav-link], [data-nav-root]') as HTMLAnchorElement | null) || null;
    if (!link) return;
    const href = link.dataset.navLink ?? link.getAttribute('href') ?? '';
    if (!href) return;
    if (isNavActive(href, window.location.pathname)) {
      event.preventDefault();
      event.stopPropagation();
      return;
    }
    // 在 ClientRouter 启动 VT、捕获 OLD 快照之前就切好 active，
    // 使新旧 header 快照一致，避免 tab 下划线在过渡层闪一下。
    updateHeader(href, { instant: true });
  }

  updateHeader();
  document.addEventListener('click', handleNavClick, true);

  document.addEventListener('astro:before-swap', (event) => {
    updateHeader(event.newDocument.location.pathname, { instant: true });
  });

  document.addEventListener('astro:page-load', () => {
    setNavLinksTransition(true);
    updateHeader();
  });
</script>
