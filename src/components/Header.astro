---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
import { cn } from '../utils/cn';

interface Props {
  currentPath: string;
  showProgress?: boolean;
}

const { currentPath, showProgress = false } = Astro.props;

function isActive(href: string) {
  if (href === '/') {
    return (
      currentPath === '/'
      || currentPath.startsWith('/category/')
      || currentPath === '/blog/'
      || currentPath === '/blog'
    );
  }
  return currentPath.startsWith(href);
}
---

<header class="fixed top-0 w-full z-50 bg-background border-b border-outline-variant" transition:persist="site-header" transition:animate="none">
  <div
    id="progress-bar"
    class:list={[
      'absolute bottom-0 left-0 h-0.5 bg-tertiary-fixed-dim transition-[width] duration-100 ease-out',
      { hidden: !showProgress },
    ]}
    style="width: 0%"
  ></div>
  <nav class="max-w-[1200px] mx-auto px-gutter flex items-center justify-between h-16">
    <div class="flex items-center gap-8">
      <a
        href="/"
        class="font-headline text-headline-md font-bold text-tertiary-fixed-dim tracking-tight"
      >
        {site.name}
      </a>
      <div class="hidden md:flex gap-6 items-center">
        {site.nav.map((item) => (
          <a
            href={item.href}
            data-nav-link={item.href}
            class={cn(
              'font-headline text-[16px] pb-1 transition-colors duration-200 cursor-pointer active:opacity-70',
              isActive(item.href)
                ? 'text-tertiary-fixed-dim border-b-2 border-tertiary-fixed-dim'
                : 'text-on-surface-variant hover:text-tertiary-fixed-dim',
            )}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
    <div class="flex items-center gap-4">
      <Search />
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  function isNavActive(href: string, path: string) {
    if (href === '/') {
      return (
        path === '/'
        || path.startsWith('/category/')
        || path === '/blog/'
        || path === '/blog'
      );
    }
    return path.startsWith(href);
  }

  function updateHeader() {
    const path = window.location.pathname;

    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      const href = link.dataset.navLink;
      if (!href) return;
      const active = isNavActive(href, path);
      link.classList.toggle('text-tertiary-fixed-dim', active);
      link.classList.toggle('border-b-2', active);
      link.classList.toggle('border-tertiary-fixed-dim', active);
      link.classList.toggle('text-on-surface-variant', !active);
    });

    const bar = document.getElementById('progress-bar');
    if (bar) {
      const isPost = /^\/blog\/[^/]+\/?$/.test(path);
      bar.classList.toggle('hidden', !isPost);
      if (!isPost) bar.style.width = '0%';
    }
  }

  updateHeader();
  document.addEventListener('astro:page-load', updateHeader);
</script>

