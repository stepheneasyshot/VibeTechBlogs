---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import CommandPalette from './CommandPalette.astro';
import ReadingProgress from './ReadingProgress.astro';
import { cn } from '../utils/cn';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(href: string) {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  if (href === '/blog') {
    return (
      currentPath === '/blog/'
      || currentPath === '/blog'
      || currentPath.startsWith('/category/')
      || /^\/blog\/[^/]+\/?$/.test(currentPath)
    );
  }
  return currentPath.startsWith(href);
}
---

<header class="fixed top-0 w-full z-50 bg-background/70 backdrop-blur-md backdrop-saturate-150 border-b border-outline-variant/60 supports-[backdrop-filter]:bg-background/60" transition:persist="site-header" transition:animate="none">
  <ReadingProgress />
  <nav class="max-w-[1200px] mx-auto px-gutter flex items-center justify-between h-12">
    <div class="flex items-center gap-3 md:gap-6 min-w-0">
      <a
        href="/"
        data-nav-root
        class="font-headline text-[15px] sm:text-[17px] md:text-[18px] font-bold text-tertiary-fixed-dim tracking-tight whitespace-nowrap"
      >
        {site.name}
      </a>
      <div class="flex gap-3 md:gap-5 items-stretch">
        {site.nav.map((item) => (
          <a
            href={item.href}
            data-nav-link={item.href}
            class={cn(
              'font-headline text-[13px] md:text-[14px] flex items-center border-b-2 -mb-px transition-colors duration-200 cursor-pointer active:opacity-70 whitespace-nowrap',
              isActive(item.href)
                ? 'text-tertiary-fixed-dim border-tertiary-fixed-dim'
                : 'text-on-surface-variant border-transparent hover:text-tertiary-fixed-dim',
            )}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
    <div class="flex items-center gap-3 min-w-0 flex-1 justify-end">
      <CommandPalette />
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  function isNavActive(href: string, path: string) {
    if (href === '/') {
      return path === '/' || path === '';
    }
    if (href === '/blog') {
      return (
        path === '/blog/'
        || path === '/blog'
        || path.startsWith('/category/')
        || /^\/blog\/[^/]+\/?$/.test(path)
      );
    }
    return path.startsWith(href);
  }

  function updateHeader(pathArg?: string) {
    const path = pathArg ?? window.location.pathname;

    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      const href = link.dataset.navLink;
      if (!href) return;
      const active = isNavActive(href, path);
      link.classList.toggle('text-tertiary-fixed-dim', active);
      link.classList.toggle('border-tertiary-fixed-dim', active);
      link.classList.toggle('border-transparent', !active);
      link.classList.toggle('text-on-surface-variant', !active);
      // 当前 tab 已激活时，阻止再次点击触发导航（避免刷新闪烁）
      if (active) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function handleNavClick(event: MouseEvent) {
    const target = event.target as Element | null;
    const link = (target?.closest?.('[data-nav-link], [data-nav-root]') as HTMLAnchorElement | null) || null;
    if (!link) return;
    const href = link.dataset.navLink ?? link.getAttribute('href') ?? '';
    if (!href) return;
    if (isNavActive(href, window.location.pathname)) {
      event.preventDefault();
      event.stopPropagation();
    }
  }

  updateHeader();
  document.addEventListener('click', handleNavClick, true);
  // 在 DOM 交换前就把 active tab 切到目标页，使 persisted header 的过渡快照与最终状态一致，避免下划线跳动
  document.addEventListener('astro:before-swap', (event) => {
    updateHeader(event.newDocument.location.pathname);
  });
  document.addEventListener('astro:page-load', () => updateHeader());
</script>
