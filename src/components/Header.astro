---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import CommandPalette from './CommandPalette.astro';
import ReadingProgress from './ReadingProgress.astro';
import { cn } from '../utils/cn';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(href: string) {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  if (href === '/blog') {
    return (
      currentPath === '/blog/'
      || currentPath === '/blog'
      || currentPath.startsWith('/category/')
      || /^\/blog\/[^/]+\/?$/.test(currentPath)
    );
  }
  return currentPath.startsWith(href);
}
---

<header class="fixed top-0 w-full z-50 bg-background/70 backdrop-blur-md backdrop-saturate-150 border-b border-outline-variant/60 supports-[backdrop-filter]:bg-background/60" transition:persist="site-header" transition:animate="none">
  <ReadingProgress />
  <nav class="max-w-[1200px] mx-auto px-gutter flex items-center justify-between h-16">
    <div class="flex items-center gap-4 md:gap-8 min-w-0">
      <a
        href="/"
        class="font-headline text-[18px] sm:text-headline-sm md:text-headline-md font-bold text-tertiary-fixed-dim tracking-tight whitespace-nowrap"
      >
        {site.name}
      </a>
      <div class="flex gap-4 md:gap-6 items-center">
        {site.nav.map((item) => (
          <a
            href={item.href}
            data-nav-link={item.href}
            class={cn(
              'font-headline text-[15px] md:text-[16px] pb-1 transition-colors duration-200 cursor-pointer active:opacity-70 whitespace-nowrap',
              isActive(item.href)
                ? 'text-tertiary-fixed-dim border-b-2 border-tertiary-fixed-dim'
                : 'text-on-surface-variant hover:text-tertiary-fixed-dim',
            )}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
    <div class="flex items-center gap-4 min-w-0 flex-1 justify-end">
      <CommandPalette />
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  function isNavActive(href: string, path: string) {
    if (href === '/') {
      return path === '/' || path === '';
    }
    if (href === '/blog') {
      return (
        path === '/blog/'
        || path === '/blog'
        || path.startsWith('/category/')
        || /^\/blog\/[^/]+\/?$/.test(path)
      );
    }
    return path.startsWith(href);
  }

  function updateHeader() {
    const path = window.location.pathname;

    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      const href = link.dataset.navLink;
      if (!href) return;
      const active = isNavActive(href, path);
      link.classList.toggle('text-tertiary-fixed-dim', active);
      link.classList.toggle('border-b-2', active);
      link.classList.toggle('border-tertiary-fixed-dim', active);
      link.classList.toggle('text-on-surface-variant', !active);
    });
  }

  updateHeader();
  document.addEventListener('astro:page-load', updateHeader);
</script>
