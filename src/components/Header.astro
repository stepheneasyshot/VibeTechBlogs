---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import CommandPalette from './CommandPalette.astro';
import ReadingProgress from './ReadingProgress.astro';
import { cn } from '../utils/cn';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(href: string) {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  if (href === '/blog') {
    return (
      currentPath === '/blog/'
      || currentPath === '/blog'
      || currentPath.startsWith('/category/')
      || /^\/blog\/[^/]+\/?$/.test(currentPath)
    );
  }
  return currentPath.startsWith(href);
}
---

<!--
  页面内使用半透明 Surface + backdrop blur；VT 快照层由 global.css 提供
  实色垫底，避免切页时内容穿透。transition:name 必须显式设置。
-->
<header
  class="site-top-app-bar fixed top-0 w-full z-50 border-b border-outline-variant/20"
  transition:persist="site-header"
  transition:name="site-header"
  transition:animate="none"
>
  <ReadingProgress />
  <nav class="max-w-[1200px] mx-auto px-3 sm:px-gutter flex items-center justify-between h-14">
    <div class="flex items-center gap-1 md:gap-5 min-w-0">
      <a
        href="/"
        data-nav-root
        class="site-brand inline-flex items-center h-10 px-1 md:px-2 font-headline text-[15px] sm:text-[17px] md:text-[20px] font-bold text-primary tracking-tight whitespace-nowrap rounded-full transition-colors hover:bg-primary/8"
      >
        {site.name}
      </a>
      <div class="flex gap-0.5 md:gap-1 items-center h-14">
        {site.nav.map((item) => (
          <a
            href={item.href}
            data-nav-link={item.href}
            class={cn(
              'site-nav-tab font-label text-[13px] md:text-[14px] font-medium inline-flex items-center justify-center h-10 px-2 md:px-4 rounded-full transition-colors duration-200 cursor-pointer whitespace-nowrap',
              isActive(item.href)
                ? 'site-nav-tab-active text-primary'
                : 'text-on-surface-variant',
            )}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
    <div class="flex items-center gap-0.5 shrink-0">
      <CommandPalette />
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  function isNavActive(href: string, path: string) {
    if (href === '/') {
      return path === '/' || path === '';
    }
    if (href === '/blog') {
      return (
        path === '/blog/'
        || path === '/blog'
        || path.startsWith('/category/')
        || /^\/blog\/[^/]+\/?$/.test(path)
      );
    }
    return path.startsWith(href);
  }

  function setNavLinksTransition(enabled: boolean) {
    document.querySelector('.site-top-app-bar')?.classList.toggle('site-nav-transitions-disabled', !enabled);
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      link.style.transition = enabled ? '' : 'none';
    });
  }

  function updateHeader(pathArg?: string, options?: { instant?: boolean }) {
    const path = pathArg ?? window.location.pathname;
    const instant = options?.instant === true;

    if (instant) setNavLinksTransition(false);

    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((link) => {
      const href = link.dataset.navLink;
      if (!href) return;
      const active = isNavActive(href, path);
      link.classList.toggle('site-nav-tab-active', active);
      link.classList.toggle('text-primary', active);
      link.classList.toggle('text-on-surface-variant', !active);
      if (active) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });

    if (instant) {
      // 强制 reflow，确保随后的 VT OLD 快照捕获到最终颜色
      void document.body.offsetWidth;
    }
  }

  function handleNavClick(event: MouseEvent) {
    const target = event.target as Element | null;
    const link = (target?.closest?.('[data-nav-link], [data-nav-root]') as HTMLAnchorElement | null) || null;
    if (!link) return;
    const href = link.dataset.navLink ?? link.getAttribute('href') ?? '';
    if (!href) return;
    if (isNavActive(href, window.location.pathname)) {
      event.preventDefault();
      event.stopPropagation();
      return;
    }
    // 在 ClientRouter 启动 VT、捕获 OLD 快照之前就切好 active，
    // 使新旧 header 快照一致，避免 tab 下划线在过渡层闪一下。
    updateHeader(href, { instant: true });
  }

  updateHeader();
  document.addEventListener('click', handleNavClick, true);

  document.addEventListener('astro:before-swap', (event) => {
    updateHeader(event.newDocument.location.pathname, { instant: true });
  });

  document.addEventListener('astro:page-load', () => {
    setNavLinksTransition(true);
    updateHeader();
  });
</script>
