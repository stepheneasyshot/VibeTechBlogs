<div class="hidden md:flex items-center bg-surface-container-low px-4 py-2 rounded-full border border-outline-variant/30 relative">
  <span class="material-symbols-outlined text-on-surface-variant text-[20px]">search</span>
  <input
    id="search-input"
    type="search"
    class="bg-transparent border-none focus:ring-0 text-label-md w-48 ml-2 placeholder:text-on-surface-variant/50 outline-none"
    placeholder="搜索文章…"
    autocomplete="off"
  />
  <div
    id="search-results"
    class="hidden absolute top-full left-0 right-0 mt-2 bg-surface-container-lowest border border-outline-variant rounded-xl shadow-lg max-h-80 overflow-y-auto z-50"
  ></div>
</div>

<script is:inline>
  let pagefind = null;

  async function loadPagefind() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
      return pagefind;
    } catch {
      return null;
    }
  }

  async function performSearch(query) {
    const resultsEl = document.getElementById('search-results');
    const input = document.getElementById('search-input');
    if (!resultsEl || !input) return;

    if (!query.trim()) {
      resultsEl.classList.add('hidden');
      resultsEl.innerHTML = '';
      return;
    }

    const pf = await loadPagefind();
    if (!pf) {
      resultsEl.classList.remove('hidden');
      resultsEl.innerHTML = '<p class="p-4 text-label-md text-on-surface-variant">搜索索引将在构建后可用（npm run build）</p>';
      return;
    }

    const search = await pf.search(query);
    const items = await Promise.all(
      search.results.slice(0, 8).map(async (r) => {
        const data = await r.data();
        return data;
      }),
    );

    if (items.length === 0) {
      resultsEl.classList.remove('hidden');
      resultsEl.innerHTML = '<p class="p-4 text-label-md text-on-surface-variant">未找到相关文章</p>';
      return;
    }

    resultsEl.classList.remove('hidden');
    resultsEl.innerHTML = items
      .map(
        (item) => `
        <a href="${item.url}" class="block p-4 hover:bg-surface-container-high transition-colors border-b border-outline-variant/20 last:border-0">
          <p class="font-label text-label-md text-primary font-medium">${item.meta.title ?? item.url}</p>
          <p class="text-sm text-on-surface-variant line-clamp-2 mt-1">${item.excerpt}</p>
        </a>`,
      )
      .join('');
  }

  function initSearch() {
    const input = document.getElementById('search-input');
    const resultsEl = document.getElementById('search-results');
    if (!input || !resultsEl) return;

    let timeout;
    input.oninput = () => {
      clearTimeout(timeout);
      timeout = setTimeout(() => performSearch(input.value), 200);
    };

    input.onfocus = () => {
      if (input.value.trim()) performSearch(input.value);
    };

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target) && !resultsEl.contains(e.target)) {
        resultsEl.classList.add('hidden');
      }
    });
  }

  initSearch();
  document.addEventListener('astro:page-load', initSearch);
</script>
