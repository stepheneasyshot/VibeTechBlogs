---
import { site } from '../data/site';
---

<footer
  id="site-footer"
  class="mt-auto shrink-0 w-full border-t border-outline-variant/40 bg-page py-2.5"
  transition:persist="site-footer"
  transition:animate="none"
>
  <div class="max-w-[1200px] mx-auto px-gutter flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1">
    <p class="font-label text-[12px] text-on-surface-variant">
      {site.tagline}
    </p>
    <span class="text-outline-variant/60 select-none" aria-hidden="true">·</span>
    <p class="font-label text-[12px] text-on-surface-variant/70 shrink-0">
      © {new Date().getFullYear()} {site.name}
    </p>
  </div>
</footer>
