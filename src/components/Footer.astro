---
import { site } from '../data/site';
---

<footer class="w-full py-stack-lg mt-stack-xl bg-surface-container-low dark:bg-surface-container-highest border-t border-outline-variant">
  <div class="max-w-[720px] mx-auto px-gutter flex flex-col items-center gap-stack-md text-center">
    <h4 class="font-headline text-headline-sm text-primary dark:text-inverse-primary tracking-tight font-bold">
      {site.name}
    </h4>
    <p class="font-label text-label-md text-on-surface-variant dark:text-surface-variant">
      探索优雅代码与 resilient 架构的交汇。
    </p>
    <nav class="flex gap-6 mb-4">
      <a href="/rss.xml" class="font-label text-label-md text-on-surface-variant hover:text-tertiary-fixed-dim transition-colors">
        RSS 订阅
      </a>
      <a href="#" class="font-label text-label-md text-on-surface-variant hover:text-tertiary-fixed-dim transition-colors">
        隐私政策
      </a>
      <a href="#" class="font-label text-label-md text-on-surface-variant hover:text-tertiary-fixed-dim transition-colors">
        服务条款
      </a>
    </nav>
    <div class="flex gap-4 mb-4">
      <a
        href={site.social.github}
        class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container hover:text-tertiary-fixed-dim transition-all"
        aria-label="GitHub"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
      </a>
      <a
        href={site.social.twitter}
        class="w-10 h-10 flex items-center justify-center rounded-full bg-surface-container hover:text-tertiary-fixed-dim transition-all"
        aria-label="Twitter"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
      </a>
    </div>
    <p class="font-label text-label-md text-secondary dark:text-secondary-fixed-dim opacity-70">
      © {new Date().getFullYear()} {site.name}. 精心构建。
    </p>
  </div>
</footer>
