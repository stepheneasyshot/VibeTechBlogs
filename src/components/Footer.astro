---
import { site } from '../data/site';
---

<footer class="w-full py-stack-md mt-stack-lg bg-background border-t border-outline-variant" transition:persist="site-footer" transition:animate="none">
  <div class="max-w-[720px] mx-auto px-gutter flex flex-col items-center gap-3 text-center">
    <p class="font-label text-label-md text-on-surface-variant">
      {site.tagline}
    </p>
    <div class="flex gap-3">
      <a
        href={site.social.github}
        class="w-9 h-9 flex items-center justify-center rounded-full border border-outline-variant text-on-surface-variant hover:text-tertiary-fixed-dim hover:border-tertiary-fixed-dim transition-all"
        aria-label="GitHub"
      >
        <svg class="w-[18px] h-[18px] fill-current" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
      </a>
      <a
        href={site.social.juejin}
        class="w-9 h-9 flex items-center justify-center rounded-full border border-outline-variant text-on-surface-variant hover:text-tertiary-fixed-dim hover:border-tertiary-fixed-dim transition-all"
        aria-label="稀土掘金"
      >
        <svg class="w-[18px] h-[18px] fill-current" viewBox="0 0 24 24"><path d="m12 14.316 7.454-5.88-2.022-1.625L12 11.1l-.004.003-5.432-4.288-2.02 1.624 7.452 5.88Zm0-7.247 2.89-2.298L12 2.453l-.004-.005-2.884 2.318 2.884 2.3Zm0 11.266-.005.002-9.975-7.87L0 12.088l.194.156 11.803 9.308 7.463-5.885L24 12.085l-2.023-1.624Z"/></svg>
      </a>
    </div>
    <p class="font-label text-[13px] text-on-surface-variant/70">
      © {new Date().getFullYear()} {site.name}. 精心构建。
    </p>
  </div>
</footer>
