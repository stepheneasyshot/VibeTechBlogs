---
import CoverImage from './CoverImage.astro';
import { formatDate, getPostUrl, getPostSlug, getPostCategories, type BlogEntry } from '../utils/posts';

interface Props {
  post: BlogEntry;
  staggerIndex?: number;
}

const { post, staggerIndex } = Astro.props;
const { title, description, pubDate, image } = post.data;
const categories = getPostCategories(post);
const url = getPostUrl(post);
const slug = getPostSlug(post);
---

<article
  class="group cursor-pointer stagger-item"
  style={staggerIndex !== undefined ? `--stagger-i: ${staggerIndex}` : undefined}
  transition:name={`post-${slug}`}
>
  <a href={url} class="block">
    <CoverImage
      src={image}
      alt={title}
      class="mb-4 w-full rounded-xl border border-outline-variant"
      imgClass="group-hover:scale-[1.02] transition-transform duration-500"
      transitionName={`cover-${slug}`}
    />
    <p class="font-label text-label-md text-secondary mb-2">
      {categories.join(' · ')} · {formatDate(pubDate)}
    </p>
    <h3
      class="font-headline text-headline-sm mb-3 group-hover:text-on-primary-container transition-colors font-semibold"
      transition:name={`title-${slug}`}
    >
      {title}
    </h3>
    <p class="font-body text-[16px] text-on-surface-variant line-clamp-3">{description}</p>
  </a>
</article>
