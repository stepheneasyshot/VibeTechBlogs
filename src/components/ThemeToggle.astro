<button
  id="theme-toggle"
  type="button"
  class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-colors p-2 cursor-pointer"
  aria-label="切换主题"
>
  light_mode
</button>

<script>
  const FALLBACK_TRANSITION_MS = 400;

  function updateToggleIcon(dark: boolean) {
    const btn = document.getElementById('theme-toggle');
    if (btn) btn.textContent = dark ? 'dark_mode' : 'light_mode';
  }

  function applyThemeClass(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    localStorage.setItem('theme', dark ? 'dark' : 'light');
    updateToggleIcon(dark);
  }

  function getRevealRadius(x: number, y: number) {
    return (
      Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      ) + 24
    );
  }

  function setThemeFallback(dark: boolean) {
    const root = document.documentElement;
    root.classList.add('theme-transition');
    void root.offsetWidth;
    applyThemeClass(dark);
    window.setTimeout(() => root.classList.remove('theme-transition'), FALLBACK_TRANSITION_MS);
  }

  function setThemeWithReveal(dark: boolean, origin: { x: number; y: number }) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canReveal =
      !reducedMotion && typeof document.startViewTransition === 'function';

    if (!canReveal) {
      setThemeFallback(dark);
      return;
    }

    const root = document.documentElement;
    const { x, y } = origin;
    const radius = getRevealRadius(x, y);

    root.style.setProperty('--theme-reveal-x', `${x}px`);
    root.style.setProperty('--theme-reveal-y', `${y}px`);
    root.style.setProperty('--theme-reveal-r', `${radius}px`);
    root.classList.add('theme-revealing');

    const transition = document.startViewTransition(() => {
      applyThemeClass(dark);
    });

    transition.finished.finally(() => {
      root.classList.remove('theme-revealing');
      root.style.removeProperty('--theme-reveal-x');
      root.style.removeProperty('--theme-reveal-y');
      root.style.removeProperty('--theme-reveal-r');
    });
  }

  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';

    updateToggleIcon(document.documentElement.classList.contains('dark'));

    btn.onclick = (event) => {
      const rect = btn.getBoundingClientRect();
      const x = event instanceof MouseEvent ? event.clientX : rect.left + rect.width / 2;
      const y = event instanceof MouseEvent ? event.clientY : rect.top + rect.height / 2;
      setThemeWithReveal(!document.documentElement.classList.contains('dark'), { x, y });
    };
  }

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
