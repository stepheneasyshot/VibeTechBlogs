<button
  id="theme-toggle"
  type="button"
  class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-colors p-2 cursor-pointer"
  aria-label="切换主题"
>
  light_mode
</button>

<script>
  function setTheme(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    localStorage.setItem('theme', dark ? 'dark' : 'light');
    const btn = document.getElementById('theme-toggle');
    if (btn) btn.textContent = dark ? 'dark_mode' : 'light_mode';
  }

  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const isDark = document.documentElement.classList.contains('dark');
    btn.textContent = isDark ? 'dark_mode' : 'light_mode';
    btn.onclick = () => setTheme(!document.documentElement.classList.contains('dark'));
  }

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
