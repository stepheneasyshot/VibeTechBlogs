---
import { site } from '../data/site';

const navItems = site.nav;
---

<button
  type="button"
  id="command-trigger"
  class="flex items-center gap-2 px-3 py-2 rounded-full border border-outline-variant/30 bg-surface-container-low text-on-surface-variant hover:border-tertiary-fixed-dim/40 hover:text-on-surface transition-colors cursor-pointer"
  aria-label="打开命令面板"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="command-palette"
>
  <span class="material-symbols-outlined text-[20px]">search</span>
  <span class="hidden md:inline font-label text-label-md">搜索…</span>
  <kbd class="hidden md:inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded border border-outline-variant/40 bg-surface-container font-label text-[11px] text-on-surface-variant/70">
    <span id="command-kbd-mod">⌘</span>K
  </kbd>
</button>

<div
  id="command-palette"
  class="command-palette fixed inset-0 z-[100] hidden"
  role="dialog"
  aria-modal="true"
  aria-label="命令面板"
  aria-hidden="true"
>
  <div
    id="command-backdrop"
    class="command-backdrop absolute inset-0 bg-background/75 backdrop-blur-sm"
  ></div>
  <div class="relative flex items-start justify-center pt-[12vh] px-gutter pointer-events-none">
    <div
      id="command-panel"
      class="command-panel pointer-events-auto w-full max-w-[560px] bg-surface-container-lowest border border-outline-variant rounded-xl shadow-2xl overflow-hidden"
    >
      <div class="flex items-center gap-3 px-4 py-3 border-b border-outline-variant/30">
        <span class="material-symbols-outlined text-[22px] text-on-surface-variant">search</span>
        <input
          id="command-input"
          type="search"
          class="flex-1 bg-transparent border-none outline-none font-label text-label-md text-on-surface placeholder:text-on-surface-variant/50"
          placeholder="搜索文章或跳转页面…"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="hidden sm:inline font-label text-[11px] text-on-surface-variant/60 px-1.5 py-0.5 rounded border border-outline-variant/30">ESC</kbd>
      </div>
      <div id="command-list" class="max-h-[min(360px,50vh)] overflow-y-auto py-2"></div>
    </div>
  </div>
</div>

<script define:vars={{ navItems }}>
  let pagefind = null;
  let activeIndex = 0;
  let currentItems = [];
  let searchTimeout;
  let reducedMotion = false;

  function getModKey() {
    return /Mac|iPhone|iPad/.test(navigator.platform) ? '⌘' : 'Ctrl';
  }

  async function loadPagefind() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
      return pagefind;
    } catch {
      return null;
    }
  }

  function getElements() {
    return {
      palette: document.getElementById('command-palette'),
      backdrop: document.getElementById('command-backdrop'),
      panel: document.getElementById('command-panel'),
      input: document.getElementById('command-input'),
      list: document.getElementById('command-list'),
      trigger: document.getElementById('command-trigger'),
      kbdMod: document.getElementById('command-kbd-mod'),
    };
  }

  function buildNavItems() {
    return navItems.map((item) => ({
      type: 'nav',
      href: item.href,
      title: item.label,
      subtitle: '页面导航',
      icon: item.href === '/' ? 'home' : item.href === '/about' ? 'person' : 'link',
    }));
  }

  function renderList(items) {
    const { list } = getElements();
    if (!list) return;

    currentItems = items;
    activeIndex = Math.min(activeIndex, Math.max(0, items.length - 1));

    if (items.length === 0) {
      list.innerHTML = '<p class="px-4 py-6 text-center font-label text-label-md text-on-surface-variant">未找到相关结果</p>';
      return;
    }

    list.innerHTML = items
      .map((item, i) => {
        const active = i === activeIndex;
        const icon = item.icon ?? 'article';
        return `
          <a
            href="${item.href}"
            data-command-index="${i}"
            style="--command-i: ${i}"
            class="command-item flex items-start gap-3 px-4 py-3 transition-colors ${active ? 'bg-surface-container-high' : 'hover:bg-surface-container'}"
          >
            <span class="material-symbols-outlined text-[20px] text-tertiary-fixed-dim mt-0.5">${icon}</span>
            <div class="min-w-0 flex-1">
              <p class="font-label text-label-md font-medium text-on-surface truncate">${item.title}</p>
              ${item.subtitle ? `<p class="font-label text-[13px] text-on-surface-variant line-clamp-2 mt-0.5">${item.subtitle}</p>` : ''}
            </div>
            ${active ? '<span class="material-symbols-outlined text-[18px] text-on-surface-variant/50">keyboard_return</span>' : ''}
          </a>`;
      })
      .join('');
  }

  async function performSearch(query) {
    const trimmed = query.trim();

    if (!trimmed) {
      renderList(buildNavItems());
      return;
    }

    const pf = await loadPagefind();
    if (!pf) {
      renderList([
        {
          type: 'info',
          href: '#',
          title: '搜索索引将在构建后可用',
          subtitle: '请运行 npm run build',
          icon: 'info',
        },
      ]);
      return;
    }

    const search = await pf.search(trimmed);
    const items = await Promise.all(
      search.results.slice(0, 8).map(async (r) => {
        const data = await r.data();
        return {
          type: 'post',
          href: data.url,
          title: data.meta.title ?? data.url,
          subtitle: data.excerpt,
          icon: 'article',
        };
      }),
    );

    renderList(items);
  }

  function openPalette() {
    const { palette, panel, input, trigger } = getElements();
    if (!palette || !panel || !input) return;

    palette.classList.remove('hidden');
    palette.setAttribute('aria-hidden', 'false');
    trigger?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('overflow-hidden');

    if (!reducedMotion) {
      panel.classList.remove('command-panel-closed');
      panel.classList.add('command-panel-open');
    }

    activeIndex = 0;
    input.value = '';
    renderList(buildNavItems());

    requestAnimationFrame(() => input.focus());
  }

  function closePalette() {
    const { palette, panel, input, trigger } = getElements();
    if (!palette || palette.classList.contains('hidden')) return;

    if (!reducedMotion) {
      panel.classList.remove('command-panel-open');
      panel.classList.add('command-panel-closed');
      setTimeout(() => {
        palette.classList.add('hidden');
        palette.setAttribute('aria-hidden', 'true');
        trigger?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        input?.blur();
      }, 180);
    } else {
      palette.classList.add('hidden');
      palette.setAttribute('aria-hidden', 'true');
      trigger?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
      input?.blur();
    }
  }

  function moveSelection(delta) {
    if (!currentItems.length) return;
    activeIndex = (activeIndex + delta + currentItems.length) % currentItems.length;
    renderList(currentItems);
    const activeEl = document.querySelector(`[data-command-index="${activeIndex}"]`);
    activeEl?.scrollIntoView({ block: 'nearest' });
  }

  function selectActive() {
    const activeEl = document.querySelector(`[data-command-index="${activeIndex}"]`);
    if (!(activeEl instanceof HTMLAnchorElement) || activeEl.href.endsWith('#')) return;
    closePalette();
    activeEl.click();
  }

  function initCommandPalette() {
    const { trigger, input, list, backdrop, kbdMod, panel } = getElements();
    if (!trigger || !input || !list || !backdrop || !panel) return;
    if (trigger.dataset.bound === '1') return;
    trigger.dataset.bound = '1';

    reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (kbdMod) kbdMod.textContent = getModKey();

    panel.classList.add('command-panel-closed');

    trigger.onclick = openPalette;
    backdrop.onclick = closePalette;

    input.oninput = () => {
      clearTimeout(searchTimeout);
      activeIndex = 0;
      searchTimeout = setTimeout(() => performSearch(input.value), 180);
    };

    list.onclick = (e) => {
      const link = e.target.closest('[data-command-index]');
      if (link) closePalette();
    };

    document.addEventListener('keydown', onKeydown);
  }

  function onKeydown(e) {
    const isOpen = !getElements().palette?.classList.contains('hidden');

    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      isOpen ? closePalette() : openPalette();
      return;
    }

    if (!isOpen) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      closePalette();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      moveSelection(1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      moveSelection(-1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      selectActive();
    }
  }

  initCommandPalette();
  document.addEventListener('astro:page-load', initCommandPalette);
</script>
