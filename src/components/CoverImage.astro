---
import { cn } from '../utils/cn';

interface Props {
  src?: string;
  alt: string;
  class?: string;
  imgClass?: string;
}

const { src, alt, class: className, imgClass } = Astro.props;
---

<div class={cn('relative w-full aspect-video overflow-hidden', className, !src && 'placeholder-cover')}>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        loading="lazy"
        class={cn('absolute inset-0 block h-full w-full object-cover', imgClass)}
      />
    ) : null
  }
</div>
