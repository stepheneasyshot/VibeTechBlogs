---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import CommandPaletteDialog from '../components/CommandPaletteDialog.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { listTransition, type PageKind, type PageTransition } from '../utils/pageTransitions';

interface Props {
  title?: string;
  description?: string;
  pageKind?: PageKind;
  pageTransition?: PageTransition;
}

const {
  title = site.title,
  description = site.description,
  pageKind = 'list',
  pageTransition = listTransition,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#131b2e" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preload" href="/fonts/MiSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/MiSans-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        function isDarkTheme() {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark') return true;
          if (stored === 'light') return false;
          return true;
        }

        function applyTheme(doc) {
          var root = doc && doc.documentElement ? doc.documentElement : document.documentElement;
          root.classList.toggle('dark', isDarkTheme());
        }

        function getPageKind(pathname) {
          if (/^\/blog\/[^/]+\/?$/.test(pathname)) return 'post';
          if (pathname.indexOf('/category/') === 0) return 'category';
          if (/^\/about\/?$/.test(pathname)) return 'static';
          return 'list';
        }

        applyTheme();
        document.documentElement.dataset.pageKind = getPageKind(window.location.pathname);

        document.addEventListener('astro:before-preparation', function (event) {
          var from = getPageKind(window.location.pathname);
          var to = getPageKind(new URL(event.to, window.location.href).pathname);
          var direction = event.direction || 'forward';
          document.documentElement.dataset.transitionFrom = from;
          document.documentElement.dataset.transitionTo = to;
          document.documentElement.dataset.transitionPair = direction + ':' + from + '->' + to;
        });

        document.addEventListener('astro:before-swap', function (e) {
          applyTheme(e.newDocument);
          var nextPath = e.newDocument.location.pathname;
          document.documentElement.dataset.pageKind = getPageKind(nextPath);
        });

        document.addEventListener('astro:page-load', function () {
          applyTheme();
          document.documentElement.dataset.pageKind = getPageKind(window.location.pathname);
        });
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header currentPath={Astro.url.pathname} />
    <CommandPaletteDialog />
    <main
      class="flex-1"
      data-page-kind={pageKind}
      transition:name="main-content"
    >
      <slot />
    </main>
    <Footer />

    <!-- 回到顶部按钮：放在 body 层级，避免 header 的 backdrop-filter 破坏 fixed 定位 -->
    <button
      type="button"
      id="back-to-top"
      class="back-to-top fixed bottom-8 right-8 z-40 flex items-center justify-center w-11 h-11 rounded-full border border-outline-variant bg-surface-container-lowest text-on-surface-variant shadow-lg cursor-pointer"
      aria-label="回到顶部"
      hidden
    >
      <span class="material-symbols-outlined text-[22px]">keyboard_arrow_up</span>
    </button>
  </body>
</html>
