---
import BaseLayout from './BaseLayout.astro';
import { postTransition } from '../utils/pageTransitions';
import CoverImage from '../components/CoverImage.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { site } from '../data/site';
import { formatDate, getReadingTime, getCategoryUrl, type TocHeading } from '../utils/posts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  categories: string[];
  body: string;
  headings: TocHeading[];
  slug: string;
  image?: string;
}

const { title, description, pubDate, categories, body, headings, slug, image } = Astro.props;
const readTime = getReadingTime(body);
---

<BaseLayout
  title={`${title} | ${site.name}`}
  description={description}
  pageKind="post"
  pageTransition={postTransition}
>
  <a
    href="/"
    data-post-back
    class="post-back-fab fixed top-20 left-8 z-40 flex items-center justify-center gap-2 h-11 px-4 rounded-full border border-outline-variant bg-surface-container-lowest text-on-surface-variant shadow-lg cursor-pointer transition-colors"
    aria-label="返回上一级"
  >
    <span class="material-symbols-outlined text-[20px]">arrow_back</span>
    <span class="font-label text-label-md">返回</span>
  </a>
  <div class="mt-32 mb-stack-xl max-w-[1200px] mx-auto px-gutter flex flex-col lg:flex-row gap-stack-xl items-start">
    <TableOfContents headings={headings} />
    <article class="w-full lg:max-w-[720px] mx-auto" transition:name={`post-${slug}`}>
      <header class="mb-stack-lg">
        <div class="flex items-center gap-3 mb-stack-md flex-wrap">
          {
            categories.map((cat) => (
              <a
                href={getCategoryUrl(cat)}
                class="px-3 py-1 bg-secondary-container text-on-secondary-container font-label text-label-md rounded-full hover:opacity-80 transition-opacity"
              >
                {cat}
              </a>
            ))
          }
          <span class="text-on-surface-variant font-label text-label-md">{readTime}</span>
        </div>
        <h1
          class="font-headline text-[32px] md:text-[48px] leading-tight font-bold text-on-surface mb-stack-md"
          transition:name={`title-${slug}`}
        >
          {title}
        </h1>
        <div class="flex items-center gap-4 pt-stack-md border-t border-outline-variant/30">
          <img
            class="w-12 h-12 rounded-full object-cover"
            src={site.author.avatar}
            alt={site.author.name}
            loading="lazy"
          />
          <div>
            <div class="font-headline text-[18px] leading-tight font-semibold">{site.author.name}</div>
            <div class="font-label text-label-md text-on-surface-variant">
              {site.author.role} · 发布于 {formatDate(pubDate)}
            </div>
          </div>
        </div>
      </header>

      <CoverImage
        src={image}
        alt={title}
        class="mb-stack-xl rounded-xl border border-outline-variant/20 shadow-sm"
        transitionName={`cover-${slug}`}
      />

      <div class="prose-blog">
        <slot />
      </div>

      <div class="mt-stack-xl pt-stack-md border-t border-outline-variant/30 flex flex-wrap gap-2">
        {
          categories.map((cat) => (
            <a
              href={getCategoryUrl(cat)}
              class="px-4 py-1.5 bg-surface-container-high rounded-full font-label text-label-md text-on-surface-variant hover:text-tertiary-fixed-dim hover:bg-surface-container transition-colors"
            >
              #{cat.toLowerCase()}
            </a>
          ))
        }
      </div>
    </article>
  </div>
</BaseLayout>

<script>
  const LANG_LABELS: Record<string, string> = {
    kotlin: 'Kotlin',
    java: 'Java',
    javascript: 'JavaScript',
    typescript: 'TypeScript',
    ts: 'TypeScript',
    js: 'JavaScript',
    python: 'Python',
    rust: 'Rust',
    go: 'Go',
    sql: 'SQL',
    bash: 'Bash',
    shell: 'Shell',
    sh: 'Shell',
    json: 'JSON',
    yaml: 'YAML',
    yml: 'YAML',
    xml: 'XML',
    html: 'HTML',
    css: 'CSS',
    markdown: 'Markdown',
    md: 'Markdown',
    plaintext: 'Text',
    text: 'Text',
  };

  function getLanguageLabel(pre: HTMLPreElement) {
    const lang = pre.dataset.language?.toLowerCase();
    if (!lang) return 'Code';
    return LANG_LABELS[lang] ?? lang.charAt(0).toUpperCase() + lang.slice(1);
  }

  function initCodeCopy() {
    document.querySelectorAll('.prose-blog pre').forEach((pre) => {
      if (!(pre instanceof HTMLPreElement)) return;
      if (pre.parentElement?.classList.contains('code-block-wrapper')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';

      const header = document.createElement('div');
      header.className = 'code-block-header';

      const label = document.createElement('span');
      label.className = 'code-block-lang text-label-md font-code text-[11px] uppercase tracking-widest';
      label.textContent = getLanguageLabel(pre);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-block-copy flex items-center gap-2 transition-colors cursor-pointer';
      btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">content_copy</span><span class="text-label-md text-[12px]">复制</span>';

      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
        await navigator.clipboard.writeText(code);
        btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">check</span><span class="text-label-md text-[12px]">已复制</span>';
        setTimeout(() => {
          btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">content_copy</span><span class="text-label-md text-[12px]">复制</span>';
        }, 2000);
      });

      header.append(label, btn);
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.append(header, pre);
    });
  }

  initCodeCopy();
  document.addEventListener('astro:page-load', initCodeCopy);

  function initPostBack() {
    document.querySelectorAll<HTMLAnchorElement>('[data-post-back]').forEach((link) => {
      link.onclick = (event) => {
        if (window.history.length > 1) {
          event.preventDefault();
          history.back();
        }
      };
    });
  }

  initPostBack();
  document.addEventListener('astro:page-load', initPostBack);
</script>
