---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`关于 | ${site.name}`} description={site.author.bio}>
  <div class="pt-32 pb-stack-xl max-w-[1200px] mx-auto px-gutter">
    <section class="flex flex-col md:flex-row items-center gap-stack-lg mb-stack-xl">
      <div class="w-48 h-48 md:w-64 md:h-64 rounded-full overflow-hidden border-2 border-outline-variant p-2 shrink-0">
        <img
          class="w-full h-full object-cover rounded-full"
          src={site.author.avatar}
          alt={site.author.name}
          loading="lazy"
        />
      </div>
      <div class="max-w-[720px]">
        <span class="font-label text-label-md text-secondary tracking-widest block mb-2 uppercase">
          {site.author.role} & 作者
        </span>
        <h1 class="font-headline text-headline-lg mb-4 text-primary font-bold">
          你好，我是 {site.author.name}。
        </h1>
        <p class="font-body text-body-lg text-on-surface-variant leading-relaxed">
          {site.author.bio}
        </p>
        <div class="flex flex-wrap gap-2 mt-6">
          {
            site.skills.map((skill) => (
              <span class="px-3 py-1 bg-secondary-container text-on-secondary-container font-label text-label-md rounded-lg">
                {skill}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mb-stack-xl">
      <h2 class="font-headline text-headline-md mb-stack-lg text-center font-semibold">我的历程</h2>
      <div class="relative max-w-[800px] mx-auto py-8">
        <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-px h-full bg-outline-variant" aria-hidden="true"></div>
        {
          site.timeline.map((item, i) => (
            <div class="mb-stack-lg relative flex flex-col md:flex-row items-center md:items-start gap-8">
              <div class={`md:w-1/2 ${i % 2 === 1 ? 'md:order-2' : 'md:text-right'}`}>
                <h3 class="font-headline text-headline-sm text-primary font-semibold">{item.title}</h3>
                <p class="font-label text-label-md text-secondary">{item.period}</p>
              </div>
              <div
                class={`absolute left-1/2 -translate-x-1/2 w-4 h-4 rounded-full border-4 border-surface z-10 hidden md:block ${item.active ? 'bg-tertiary-fixed-dim' : 'bg-outline-variant'}`}
                aria-hidden="true"
              ></div>
              <div class={`md:w-1/2 ${i % 2 === 1 ? 'md:order-1 md:text-right' : ''}`}>
                <p class="text-on-surface-variant font-body">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="max-w-[720px] mx-auto text-center border border-outline-variant bg-surface-container-lowest p-stack-lg rounded-xl shadow-sm">
      <h2 class="font-headline text-headline-sm mb-4 font-semibold">与我联系</h2>
      <p class="text-on-surface-variant mb-stack-md font-body">
        欢迎讨论技术挑战、开源协作或演讲邀请。
      </p>
      <div class="flex justify-center gap-stack-md mt-6 flex-wrap">
        <a
          href={site.social.github}
          class="group flex items-center gap-2 text-on-surface-variant hover:text-tertiary-fixed-dim transition-all"
        >
          <span class="p-3 bg-surface-container-high rounded-full group-hover:bg-primary group-hover:text-surface transition-all">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.042-1.416-4.042-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
          </span>
          <span class="font-label text-label-md hidden sm:block">GitHub</span>
        </a>
        <a
          href={site.social.linkedin}
          class="group flex items-center gap-2 text-on-surface-variant hover:text-tertiary-fixed-dim transition-all"
        >
          <span class="p-3 bg-surface-container-high rounded-full group-hover:bg-[#0077b5] group-hover:text-surface transition-all">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path></svg>
          </span>
          <span class="font-label text-label-md hidden sm:block">LinkedIn</span>
        </a>
        <a
          href={site.social.twitter}
          class="group flex items-center gap-2 text-on-surface-variant hover:text-tertiary-fixed-dim transition-all"
        >
          <span class="p-3 bg-surface-container-high rounded-full group-hover:bg-[#1da1f2] group-hover:text-surface transition-all">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"></path></svg>
          </span>
          <span class="font-label text-label-md hidden sm:block">Twitter</span>
        </a>
      </div>
      <div class="mt-stack-lg">
        <button
          type="button"
          class="bg-primary text-on-primary px-8 py-3 rounded-lg font-label text-label-md hover:opacity-90 transition-opacity active:scale-95 cursor-pointer"
        >
          订阅 Newsletter
        </button>
      </div>
    </section>
  </div>
</BaseLayout>
