---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { staticTransition } from '../utils/pageTransitions';
---

<BaseLayout title={`关于 | ${site.name}`} description={site.author.bio} pageKind="static" pageTransition={staticTransition}>
  <div class="pt-32 pb-stack-md max-w-[1200px] mx-auto px-gutter">
    <section class="flex flex-col md:flex-row items-center gap-stack-lg mb-stack-xl">
      <div class="w-48 h-48 md:w-64 md:h-64 rounded-full overflow-hidden border-2 border-outline-variant p-2 shrink-0">
        <img
          class="w-full h-full object-cover rounded-full"
          src={site.author.avatar}
          alt={site.author.name}
          loading="lazy"
        />
      </div>
      <div class="max-w-[720px]">
        <span class="font-label text-label-md text-secondary tracking-widest block mb-2 uppercase">
          {site.author.role} & 作者
        </span>
        <h1 class="font-headline text-headline-lg mb-4 text-primary font-bold">
          你好，我是 {site.author.name}。
        </h1>
        <div class="font-body text-body-lg text-on-surface-variant leading-relaxed space-y-4">
          {
            site.author.bio.split('\n\n').map((paragraph) => (
              <p>{paragraph}</p>
            ))
          }
        </div>
        <div class="flex flex-wrap gap-2 mt-6">
          {
            site.skills.map((skill) => (
              <span class="px-3 py-1 bg-secondary-container text-on-secondary-container font-label text-label-md rounded-lg">
                {skill}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <section>
      <h2 class="font-headline text-headline-md mb-stack-lg text-center font-semibold">我的历程</h2>
      <div class="relative max-w-[800px] mx-auto pt-8">
        <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-px h-full bg-outline-variant" aria-hidden="true"></div>
        {
          site.timeline.map((item, i) => (
            <div class="mb-stack-lg last:mb-0 relative flex flex-col md:flex-row items-center md:items-start gap-8">
              <div class={`md:w-1/2 ${i % 2 === 1 ? 'md:order-2' : 'md:text-right'}`}>
                <h3 class="font-headline text-headline-sm text-primary font-semibold">{item.title}</h3>
                <p class="font-label text-label-md text-secondary">{item.period}</p>
              </div>
              <div
                class={`absolute left-1/2 -translate-x-1/2 w-4 h-4 rounded-full border-4 border-surface z-10 hidden md:block ${item.active ? 'bg-tertiary-fixed-dim' : 'bg-outline-variant'}`}
                aria-hidden="true"
              ></div>
              <div class={`md:w-1/2 ${i % 2 === 1 ? 'md:order-1 md:text-right' : ''}`}>
                <p class="text-on-surface-variant font-body">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
