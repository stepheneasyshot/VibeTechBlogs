---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectExplorer from '../components/ProjectExplorer.astro';
import { site } from '../data/site';
import { staticTransition } from '../utils/pageTransitions';
---

<BaseLayout title={`关于 | ${site.name}`} description={site.author.bio} pageKind="static" pageTransition={staticTransition}>
  <div class="pt-20 pb-stack-md max-w-[1200px] mx-auto px-gutter">
    <section class="flex flex-col md:flex-row items-center gap-stack-lg mb-stack-xl">
      <div class="w-48 h-48 md:w-64 md:h-64 rounded-full overflow-hidden elevation-2 p-1.5 bg-surface-container-highest shrink-0">
        <img
          class="w-full h-full object-cover rounded-full"
          src={site.author.avatar}
          alt={site.author.name}
          loading="lazy"
        />
      </div>
      <div class="max-w-[720px]">
        <span class="font-label text-label-md text-on-surface-variant tracking-widest block mb-2 uppercase">
          {site.author.role} & 作者
        </span>
        <h1 class="font-headline text-headline-md mb-4 text-on-surface font-bold">
          你好，我是 {site.author.name}。
        </h1>
        <div class="font-body text-body-md text-on-surface-variant leading-relaxed space-y-4">
          {
            site.author.bio.split('\n\n').map((paragraph) => (
              <p>{paragraph}</p>
            ))
          }
        </div>
        <div class="flex flex-wrap gap-2 mt-6">
          {
            site.skills.map((skill) => (
              <span class="px-3 py-1 bg-secondary-container text-on-secondary-container font-label text-label-md rounded-full">
                {skill}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mb-stack-xl">
      <h2 class="font-headline text-headline-md mb-stack-md text-center font-semibold">我的历程</h2>
      <div class="relative max-w-[800px] mx-auto pt-4 before:content-[''] before:absolute before:left-2 before:top-4 before:bottom-0 before:w-px before:bg-outline-variant md:before:hidden">
        <div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-px h-full bg-outline-variant" aria-hidden="true"></div>
        {
          site.timeline.map((item, i) => (
            <div class="mb-stack-lg last:mb-0 relative flex flex-col md:flex-row items-start md:items-start gap-6 md:gap-8 pl-8 md:pl-0">
              <div class={`md:w-1/2 ${i % 2 === 1 ? 'md:order-2' : 'md:text-right'}`}>
                <h3 class="font-headline text-headline-sm text-on-surface font-semibold">{item.title}</h3>
                <p class="font-label text-label-md text-on-surface-variant">{item.period}</p>
              </div>
              <div
                class={`absolute left-2 md:left-1/2 -translate-x-1/2 top-1 w-3 md:w-4 h-3 md:h-4 rounded-full border-2 md:border-4 border-surface z-10 ${item.active ? 'bg-tertiary-fixed-dim' : 'bg-outline-variant'}`}
                aria-hidden="true"
              ></div>
              <div class={`md:w-1/2 space-y-1.5 ${i % 2 === 1 ? 'md:order-1 md:text-right' : ''}`}>
                {
                  item.description.split('\n').map((line) => (
                    <p class="text-on-surface-variant font-body text-body-md leading-relaxed">{line}</p>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-stack-xl">
      <h2 class="font-headline text-headline-md mb-stack-lg text-center font-semibold">开源项目</h2>
      <ProjectExplorer />
    </section>

    <section class="pb-stack-lg">
      <h2 class="font-headline text-headline-md mb-stack-lg text-center font-semibold">找到我</h2>
      <div class="max-w-[800px] mx-auto flex flex-col gap-3">
        <a
          href={site.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-5 rounded-xl bg-surface-container-low elevation-1 px-5 py-5 hover:elevation-2 transition-[box-shadow] no-underline"
        >
          <span class="w-14 h-14 rounded-xl bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.43.372.823 1.102.823 2.222 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="font-headline text-headline-sm text-on-surface font-semibold block">GitHub</span>
            <span class="font-label text-label-md text-on-surface-variant block truncate">@stepheneasyshot · 开源与项目</span>
          </span>
          <span class="material-symbols-outlined text-on-surface-variant group-hover:text-tertiary-fixed-dim group-hover:translate-x-0.5 transition-all shrink-0">arrow_outward</span>
        </a>

        <a
          href={site.social.juejin}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-5 rounded-xl bg-surface-container-low elevation-1 px-5 py-5 hover:elevation-2 transition-[box-shadow] no-underline"
        >
          <span class="w-14 h-14 rounded-xl bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 14.316 7.454-5.88-2.022-1.625L12 11.1l-.004.003-5.432-4.288-2.02 1.624 7.452 5.88Zm0-7.247 2.89-2.298L12 2.453l-.004-.005-2.884 2.318 2.884 2.3Zm0 11.266-.005.002-9.975-7.87L0 12.088l.194.156 11.803 9.308 7.463-5.885L24 12.085l-2.023-1.624Z"/></svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="font-headline text-headline-sm text-on-surface font-semibold block">稀土掘金</span>
            <span class="font-label text-label-md text-on-surface-variant block truncate">技术文章与分享</span>
          </span>
          <span class="material-symbols-outlined text-on-surface-variant group-hover:text-tertiary-fixed-dim group-hover:translate-x-0.5 transition-all shrink-0">arrow_outward</span>
        </a>

        <a
          href={`mailto:${site.social.email}`}
          class="group flex items-center gap-5 rounded-xl bg-surface-container-low elevation-1 px-5 py-5 hover:elevation-2 transition-[box-shadow] no-underline"
        >
          <span class="w-14 h-14 rounded-xl bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[28px]">mail</span>
          </span>
          <span class="min-w-0 flex-1">
            <span class="font-headline text-headline-sm text-on-surface font-semibold block">邮箱</span>
            <span class="font-label text-label-md text-on-surface-variant block truncate">{site.social.email}</span>
          </span>
          <span class="material-symbols-outlined text-on-surface-variant group-hover:text-tertiary-fixed-dim group-hover:translate-x-0.5 transition-all shrink-0">arrow_outward</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
