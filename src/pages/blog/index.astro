---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import BlogCard from '../../components/BlogCard.astro';
import { site } from '../../data/site';
import { getPublishedPosts, getCategories } from '../../utils/posts';

const allPosts = await getPublishedPosts();
const categories = getCategories(allPosts);
---

<BaseLayout
  title={`全部文章 | ${site.name}`}
  description={`${site.name} 的全部技术文章，共 ${allPosts.length} 篇。`}
>
  <div class="pt-32 pb-stack-xl max-w-[1200px] mx-auto px-gutter" data-pagefind-ignore="all">
    <div class="flex flex-col lg:flex-row gap-12">
      <CategoryNav categories={categories} activeCategory={null} allHref="/blog/" />

      <section class="flex-grow min-w-0">
        <header class="mb-stack-lg stagger-item" style="--stagger-i: 0">
          <h1 class="font-headline text-headline-md font-bold mb-2">全部文章</h1>
          <p class="font-label text-label-md text-on-surface-variant">
            共 {allPosts.length} 篇文章
          </p>
        </header>

        {
          allPosts.length === 0 ? (
            <p class="font-body text-body-md text-on-surface-variant py-12 text-center">
              暂无文章。
            </p>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-12">
              {allPosts.map((post, index) => (
                <BlogCard post={post} staggerIndex={index + 1} />
              ))}
            </div>
          )
        }
      </section>
    </div>
  </div>
</BaseLayout>
