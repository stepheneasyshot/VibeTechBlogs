---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverImage from '../components/CoverImage.astro';
import { site } from '../data/site';
import { friendLinks, recommendedReading } from '../data/links';
import {
  getPublishedPosts,
  getPostUrl,
  formatDate,
} from '../utils/posts';
import { listTransition } from '../utils/pageTransitions';

const CAROUSEL_POST_LIMIT = 5;

const allPosts = await getPublishedPosts();
const featuredPosts = allPosts.filter((p) => p.data.featured);
const restPosts = allPosts.filter((p) => !p.data.featured);
const carouselPosts = [...featuredPosts, ...restPosts].slice(0, CAROUSEL_POST_LIMIT);

// Recommended reading: random gradient palette with hue-distance guard so
// adjacent cards don't share a similar color family. Same two-radial-spot +
// 135° linear-gradient structure as the tech-resource cards.
const readingGradientPalette: { hue: number; g: string }[] = [
  { hue: 140, g: 'radial-gradient(circle at 18% 22%, rgba(52, 168, 83, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(15, 130, 73, 0.72), transparent 55%), linear-gradient(135deg, #34A053, #0F8C46)' },
  { hue: 175, g: 'radial-gradient(circle at 18% 22%, rgba(20, 165, 140, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(15, 103, 103, 0.72), transparent 55%), linear-gradient(135deg, #14A895, #0F6E66)' },
  { hue: 195, g: 'radial-gradient(circle at 18% 22%, rgba(6, 170, 195, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(14, 105, 130, 0.72), transparent 55%), linear-gradient(135deg, #06A8C3, #0E6E82)' },
  { hue: 215, g: 'radial-gradient(circle at 18% 22%, rgba(74, 133, 224, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(30, 91, 176, 0.72), transparent 55%), linear-gradient(135deg, #4A85E0, #1E5BB0)' },
  { hue: 235, g: 'radial-gradient(circle at 18% 22%, rgba(92, 107, 192, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(40, 53, 147, 0.72), transparent 55%), linear-gradient(135deg, #5C6BC0, #283593)' },
  { hue: 260, g: 'radial-gradient(circle at 18% 22%, rgba(122, 86, 232, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(69, 39, 160, 0.72), transparent 55%), linear-gradient(135deg, #7A56E8, #4527A0)' },
  { hue: 290, g: 'radial-gradient(circle at 18% 22%, rgba(171, 71, 188, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(106, 27, 154, 0.72), transparent 55%), linear-gradient(135deg, #AB47BC, #6A1B9A)' },
  { hue: 320, g: 'radial-gradient(circle at 18% 22%, rgba(192, 80, 160, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(123, 31, 110, 0.72), transparent 55%), linear-gradient(135deg, #C050A0, #7B1F6E)' },
  { hue: 345, g: 'radial-gradient(circle at 18% 22%, rgba(226, 68, 98, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(173, 20, 87, 0.72), transparent 55%), linear-gradient(135deg, #E24462, #AD1457)' },
  { hue: 10, g: 'radial-gradient(circle at 18% 22%, rgba(225, 90, 90, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(176, 28, 28, 0.72), transparent 55%), linear-gradient(135deg, #E15A5A, #B71C1C)' },
  { hue: 30, g: 'radial-gradient(circle at 18% 22%, rgba(232, 146, 32, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(204, 81, 0, 0.72), transparent 55%), linear-gradient(135deg, #E89220, #CC5100)' },
  { hue: 50, g: 'radial-gradient(circle at 18% 22%, rgba(236, 198, 42, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(199, 126, 0, 0.72), transparent 55%), linear-gradient(135deg, #ECC62A, #C77E00)' },
  { hue: 70, g: 'radial-gradient(circle at 18% 22%, rgba(168, 184, 42, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(107, 122, 14, 0.72), transparent 55%), linear-gradient(135deg, #A8B82A, #6B7A0E)' },
  { hue: 210, g: 'radial-gradient(circle at 18% 22%, rgba(79, 94, 224, 0.72), transparent 55%), radial-gradient(circle at 82% 78%, rgba(42, 51, 64, 0.72), transparent 55%), linear-gradient(135deg, #4F5EE0, #2A3340)' },
];

function hueDistance(a: number, b: number): number {
  const d = Math.abs(a - b) % 360;
  return Math.min(d, 360 - d);
}

function shuffleArray<T>(arr: T[]): T[] {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function pickReadingGradients(count: number): string[] {
  for (let attempt = 0; attempt < 80; attempt++) {
    const shuffled = shuffleArray(readingGradientPalette).slice(0, count);
    let ok = true;
    for (let i = 1; i < shuffled.length; i++) {
      if (hueDistance(shuffled[i].hue, shuffled[i - 1].hue) < 60) {
        ok = false;
        break;
      }
    }
    if (ok) return shuffled.map((p) => p.g);
  }
  return shuffleArray(readingGradientPalette)
    .slice(0, count)
    .map((p) => p.g);
}

const readingGradients = pickReadingGradients(recommendedReading.length);
---

<BaseLayout title={site.title} description={site.description} pageKind="list" pageTransition={listTransition}>
  <div class="pt-20 pb-stack-xl max-w-[1200px] mx-auto px-gutter" data-pagefind-ignore="all">
    <!-- Hero / Manifesto + Carousel -->
    <section class="mb-stack-lg">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(320px,440px)] gap-12 lg:gap-14 items-start">
        <!-- Manifesto -->
        <div class="max-w-content-width">
          <p
            class="font-label text-label-md text-on-primary-container mb-4 tracking-widest uppercase stagger-item"
            style="--stagger-i: 0"
          >
            {site.hero.eyebrow}
          </p>
        <h1
          class="font-headline text-headline-md mb-stack-md leading-tight font-bold stagger-item"
          style="--stagger-i: 1"
        >
          {site.hero.title}
        </h1>
          <p
            class="font-body text-body-lg text-on-surface-variant max-w-[560px] stagger-item"
            style="--stagger-i: 2"
          >
            {site.hero.description}
          </p>

          <div class="flex flex-wrap gap-3 mt-stack-md stagger-item" style="--stagger-i: 3">
            <a
              href="/blog/"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-tertiary-fixed-dim text-on-tertiary-fixed font-label text-label-md hover:bg-tertiary-fixed transition-colors"
            >
              阅读博客
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
          </div>
        </div>

        <!-- Latest posts carousel -->
        {
          carouselPosts.length > 0 && (
            <div
              class="home-carousel stagger-item relative lg:sticky lg:top-20"
              style="--stagger-i: 4"
              data-carousel
              data-interval="4500"
            >
              <div class="home-carousel__viewport relative aspect-video rounded-2xl border border-outline-variant bg-surface-container-lowest overflow-hidden touch-pan-y">
                <div class="home-carousel__track absolute inset-0">
                  {carouselPosts.map((post, index) => {
                    return (
                      <article
                        class="home-carousel__slide absolute inset-0"
                        data-slide={index}
                        style={`--slide-i: ${index}`}
                      >
                        <a href={getPostUrl(post)} class="group block h-full">
                          <CoverImage
                            src={post.data.image}
                            alt={post.data.title}
                            class="absolute inset-0 h-full w-full rounded-none border-0"
                            imgClass="group-hover:scale-105 transition-transform duration-700"
                          />
                          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent" />
                          <div class="absolute inset-x-0 bottom-0 p-5 text-white">
                            <p class="font-label text-label-md text-white/70 mb-2 tracking-wider">
                              {formatDate(post.data.pubDate)}
                            </p>
                            <h2
                              class="font-headline text-[0.95rem] leading-snug font-semibold mb-2 line-clamp-2"
                            >
                              {post.data.title}
                            </h2>
                            <p class="font-body text-[12px] text-white/75 line-clamp-2">
                              {post.data.description}
                            </p>
                          </div>
                        </a>
                      </article>
                    );
                  })}
                </div>

                <!-- Prev / Next -->
                <button
                  type="button"
                  class="home-carousel__btn home-carousel__btn--prev absolute top-1/2 left-3 -translate-y-1/2 w-9 h-9 rounded-full bg-black/40 text-white hover:bg-black/60 backdrop-blur-sm flex items-center justify-center transition-colors"
                  data-carousel-prev
                  aria-label="上一篇"
                >
                  <span class="material-symbols-outlined text-[20px]">chevron_left</span>
                </button>
                <button
                  type="button"
                  class="home-carousel__btn home-carousel__btn--next absolute top-1/2 right-3 -translate-y-1/2 w-9 h-9 rounded-full bg-black/40 text-white hover:bg-black/60 backdrop-blur-sm flex items-center justify-center transition-colors"
                  data-carousel-next
                  aria-label="下一篇"
                >
                  <span class="material-symbols-outlined text-[20px]">chevron_right</span>
                </button>
              </div>

              <!-- Dots -->
              <div class="home-carousel__dots mt-4 flex items-center justify-center gap-2">
                {carouselPosts.map((_, index) => (
                  <button
                    type="button"
                    class="home-carousel__dot"
                    data-carousel-dot={index}
                    aria-label={`第 ${index + 1} 篇`}
                  />
                ))}
              </div>
            </div>
          )
        }
      </div>
    </section>

    <!-- Tech resources / Friend links -->
    <section class="mb-stack-xl">
      <div class="flex items-center gap-2 mb-stack-lg border-l-4 border-tertiary-fixed-dim pl-4">
        <h2 class="font-headline text-headline-sm text-on-surface font-semibold">技术资源</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
        {
          friendLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="relative overflow-hidden border border-outline-variant rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-lg transition-all duration-300 group hover:-translate-y-1 block"
            >
              {link.gradient && (
                <div
                  class="absolute inset-0"
                  style={`background-image: ${link.gradient};`}
                  aria-hidden="true"
                />
              )}
              {link.gradient && (
                <div
                  class="absolute inset-0 backdrop-blur-md backdrop-saturate-150 bg-surface-container-lowest/60 dark:bg-surface-container-lowest/55"
                  aria-hidden="true"
                />
              )}
              <div class="relative p-5 flex flex-col h-full">
                <div class="flex items-start justify-between mb-3">
                  <div class="w-10 h-10 rounded-full bg-secondary-container/80 flex items-center justify-center text-on-secondary-container">
                    <span class="material-symbols-outlined text-[20px]">{link.icon}</span>
                  </div>
                  <span class="text-on-surface-variant group-hover:translate-x-1 group-hover:text-tertiary-fixed-dim transition-all">
                    <span class="material-symbols-outlined text-[20px]">arrow_outward</span>
                  </span>
                </div>
                <h3 class="font-headline text-headline-sm mb-1 text-on-surface font-semibold leading-tight">{link.title}</h3>
                <p class="font-label text-label-md text-on-surface-variant flex-1 leading-snug">{link.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Recommended reading -->
    <section>
      <div class="flex items-center gap-2 mb-stack-lg border-l-4 border-tertiary-fixed-dim pl-4">
        <h2 class="font-headline text-headline-sm text-on-surface font-semibold">推荐阅读</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
        {
          recommendedReading.map((item, i) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="relative overflow-hidden border border-outline-variant rounded-lg bg-surface-container-lowest shadow-sm hover:shadow-lg transition-all duration-300 group hover:-translate-y-1 block"
            >
              <div
                class="absolute inset-0"
                style={`background-image: ${readingGradients[i]};`}
                aria-hidden="true"
              />
              <div
                class="absolute inset-0 backdrop-blur-md backdrop-saturate-150 bg-surface-container-lowest/60 dark:bg-surface-container-lowest/55"
                aria-hidden="true"
              />
              <div class="relative p-3 flex flex-col h-full min-h-[96px]">
                <div class="flex items-center justify-between mb-1.5">
                  <div class="w-7 h-7 rounded-full bg-secondary-container/80 flex items-center justify-center text-on-secondary-container">
                    <span class="material-symbols-outlined text-[16px]">{item.icon}</span>
                  </div>
                  <span class="text-on-surface-variant group-hover:translate-x-1 group-hover:text-tertiary-fixed-dim transition-all">
                    <span class="material-symbols-outlined text-[16px]">arrow_outward</span>
                  </span>
                </div>
                <h3 class="font-headline text-[13px] mb-0.5 text-on-surface font-semibold leading-tight line-clamp-2">{item.title}</h3>
                <p class="font-label text-[11px] text-on-surface-variant flex-1 line-clamp-2 leading-tight">{item.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-carousel__slide {
    opacity: 0;
    transform: scale(1.02);
    transition:
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  .home-carousel__slide.is-active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .home-carousel__dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-outline-variant);
    border: none;
    padding: 0;
    cursor: pointer;
    transition:
      width 0.3s ease,
      background 0.3s ease;
  }
  .home-carousel__dot.is-active {
    width: 20px;
    background: var(--color-tertiary-fixed-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-carousel__slide {
      transition: opacity 0.2s linear;
      transform: none;
    }
  }
</style>

<script>
  (function () {
    const SWIPE_THRESHOLD = 40;
    const SWIPE_AXIS_RATIO = 1.2;

    function initCarousel(root: HTMLElement) {
      if (root.dataset.carouselReady === 'true') return;
      root.dataset.carouselReady = 'true';

      const viewport = root.querySelector<HTMLElement>('.home-carousel__viewport');
      const slides = Array.from(
        root.querySelectorAll<HTMLElement>('.home-carousel__slide'),
      );
      const dots = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'),
      );
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
      if (slides.length === 0) return;

      const interval = Number(root.dataset.interval ?? '4500');
      let current = 0;
      let timer: number | undefined;

      function show(index: number) {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('is-active', i === current));
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
      }

      function next() {
        show(current + 1);
      }

      function prev() {
        show(current - 1);
      }

      function start() {
        stop();
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        timer = window.setInterval(next, interval);
      }

      function stop() {
        if (timer !== undefined) {
          window.clearInterval(timer);
          timer = undefined;
        }
      }

      nextBtn?.addEventListener('click', () => {
        next();
        start();
      });
      prevBtn?.addEventListener('click', () => {
        prev();
        start();
      });
      dots.forEach((dot, i) =>
        dot.addEventListener('click', () => {
          show(i);
          start();
        }),
      );

      // 触摸 / 指针滑动翻页（横滑切页，竖滑仍交给页面滚动）
      if (viewport && slides.length > 1) {
        let pointerId: number | null = null;
        let startX = 0;
        let startY = 0;
        let tracking = false;
        let locked: 'x' | 'y' | null = null;
        let swiped = false;

        function onPointerDown(event: PointerEvent) {
          if (event.pointerType === 'mouse' && event.button !== 0) return;
          // 按钮自己处理点击，不参与滑动
          if ((event.target as Element | null)?.closest?.('button')) return;

          pointerId = event.pointerId;
          startX = event.clientX;
          startY = event.clientY;
          tracking = true;
          locked = null;
          swiped = false;
          stop();
        }

        function onPointerMove(event: PointerEvent) {
          if (!tracking || event.pointerId !== pointerId) return;

          const dx = event.clientX - startX;
          const dy = event.clientY - startY;

          if (!locked) {
            if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
            locked =
              Math.abs(dx) > Math.abs(dy) * SWIPE_AXIS_RATIO
                ? 'x'
                : Math.abs(dy) > Math.abs(dx) * SWIPE_AXIS_RATIO
                  ? 'y'
                  : null;
            if (locked === 'y') {
              tracking = false;
              start();
              return;
            }
          }

          if (locked === 'x') {
            // 已判定为横滑：阻止默认，避免拖出文字选中 / 误触链接
            event.preventDefault();
          }
        }

        function onPointerUp(event: PointerEvent) {
          if (!tracking || event.pointerId !== pointerId) return;

          const dx = event.clientX - startX;
          const dy = event.clientY - startY;
          tracking = false;
          pointerId = null;

          if (locked === 'x' && Math.abs(dx) >= SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy)) {
            swiped = true;
            if (dx < 0) next();
            else prev();
          }

          locked = null;
          start();
        }

        function onPointerCancel(event: PointerEvent) {
          if (event.pointerId !== pointerId) return;
          tracking = false;
          pointerId = null;
          locked = null;
          start();
        }

        // 滑动结束后吞掉紧随其后的 click，避免误进文章
        viewport.addEventListener(
          'click',
          (event) => {
            if (!swiped) return;
            event.preventDefault();
            event.stopPropagation();
            swiped = false;
          },
          true,
        );

        viewport.addEventListener('pointerdown', onPointerDown);
        viewport.addEventListener('pointermove', onPointerMove, { passive: false });
        viewport.addEventListener('pointerup', onPointerUp);
        viewport.addEventListener('pointercancel', onPointerCancel);
      }

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      show(0);
      start();
    }

    function initAll() {
      document
        .querySelectorAll<HTMLElement>('[data-carousel]')
        .forEach(initCarousel);
    }

    initAll();
    document.addEventListener('astro:page-load', initAll);
  })();
</script>
