{
  "name": "vibetechblogs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "generate:themes": "node --experimental-strip-types scripts/generate-themes.ts",
    "verify:themes": "node --experimental-strip-types scripts/verify-themes.ts",
    "predev": "npm run generate:themes",
    "dev": "astro dev",
    "prebuild": "npm run generate:themes",
    "build": "astro build && pagefind --site dist && npm run verify:themes && node scripts/verify-transitions.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@tailwindcss/vite": "^4.1.8",
    "astro": "^5.7.10",
    "clsx": "^2.1.1",
    "pagefind": "^1.3.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "typescript": "^5.8.3"
  }
}
